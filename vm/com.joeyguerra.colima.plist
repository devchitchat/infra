<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        LaunchAgent — runs at user login.
        Starts Colima (Docker daemon via macOS Virtualization.Framework).
        Must be a LaunchAgent (not Daemon) because Virtualization.Framework
        requires a user session.
    -->
    <key>Label</key>
    <string>com.joeyguerra.colima</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>bash</string>
        <string>/Users/joeyguerra/src/infra/vm/start-colima.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <false/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/joeyguerra</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/joeyguerra/Library/Logs/colima.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/joeyguerra/Library/Logs/colima.log</string>
</dict>
</plist>
