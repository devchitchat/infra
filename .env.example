# Copy this to .env and fill in your values.
# .env is gitignored — never commit it.
#
# Get your host pubkey by running:
#   mesh identity   (on your host mesh node)
# or reading it from a running agent pod:
#   kubectl exec deployment/agent -c mesh -- grep pubkey /home/mesh/.mesh/mesh.toml

# Public key of the host mesh node that pods will peer with
MESH_PEER_PUBKEY=ed25519:<your-host-pubkey-here>

# Name and address of the host mesh node
MESH_PEER_NAME=joeyguerra
MESH_PEER_ADDR=host.lima.internal:7979
